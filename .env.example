#--------------------------------------------------------------------
# GANISPH — contoh konfigurasi lingkungan
# Salin file ini menjadi .env, lalu sesuaikan nilainya.
#   cp .env.example .env
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# LINGKUNGAN
# Untuk produksi gunakan: production
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APLIKASI
# Ganti baseURL dengan alamat aplikasi Anda. Wajib diakhiri garis miring.
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'

# Aktifkan pada produksi yang sudah memakai HTTPS:
# app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# SESI
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.expiration = 28800
session.cookieName = ganisph_session
session.savePath = null

# Wajib true pada produksi HTTPS:
# cookie.secure = true

#--------------------------------------------------------------------
# KEAMANAN
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.regenerate = true

#--------------------------------------------------------------------
# LOGGER
# 4 = hanya error; gunakan 7 sementara saat menelusuri masalah.
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# DATABASE
# GANISPH memakai SQLite pada writable/database/ganisph.sqlite.
# Ubah hanya bila Anda memahami konfigurasi app/Config/Database.php.
#--------------------------------------------------------------------
# database.default.database = /jalur/ke/ganisph.sqlite
